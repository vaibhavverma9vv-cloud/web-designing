
const express = require("express");
const app = express();

app.use(express.json());

let books = [
  {
    id: 1,
    title: "Learning HTML",
    author: "Sample Author",
    year: 2022,
  },
  {
    id: 2,
    title: "Introduction to JavaScript",
    author: "Sample Writer",
    year: 2023,
  },
];

let nextId = 3;

// Home route
app.get("/", (req, res) => {
  res.send("Book API is running. Use /api/books to manage books.");
});

// Get all books
app.get("/api/books", (req, res) => {
  res.json(books);
});

// Get a single book by ID
app.get("/api/books/:id", (req, res) => {
  const book = books.find(
    (item) => item.id === Number(req.params.id)
  );

  if (!book) {
    return res.status(404).json({ message: "Book not found" });
  }

  res.json(book);
});

// Add a new book
app.post("/api/books", (req, res) => {
  const { title, author, year } = req.body;

  if (!title || !author || !Number.isInteger(Number(year))) {
    return res.status(400).json({
      message: "Title, author, and numeric year are required",
    });
  }

  const book = {
    id: nextId++,
    title: title.trim(),
    author: author.trim(),
    year: Number(year),
  };

  books.push(book);

  res.status(201).json(book);
});

// Update a book
app.patch("/api/books/:id", (req, res) => {
  const book = books.find(
    (item) => item.id === Number(req.params.id)
  );

  if (!book) {
    return res.status(404).json({ message: "Book not found" });
  }

  const { title, author, year } = req.body;

  if (title !== undefined) {
    if (!String(title).trim()) {
      return res.status(400).json({
        message: "Title cannot be empty",
      });
    }

    book.title = String(title).trim();
  }

  if (author !== undefined) {
    if (!String(author).trim()) {
      return res.status(400).json({
        message: "Author cannot be empty",
      });
    }

    book.author = String(author).trim();
  }

  if (year !== undefined) {
    if (!Number.isInteger(Number(year))) {
      return res.status(400).json({
        message: "Year must be numeric",
      });
    }

    book.year = Number(year);
  }

  res.json(book);
});

// Delete a book
app.delete("/api/books/:id", (req, res) => {
  const index = books.findIndex(
    (item) => item.id === Number(req.params.id)
  );

  if (index === -1) {
    return res.status(404).json({ message: "Book not found" });
  }

  const removed = books.splice(index, 1)[0];

  res.json({
    message: "Book deleted successfully",
    book: removed,
  });
});

// Start server
const PORT = process.env.PORT || 3000;

app.listen(PORT, () => {
  console.log(`Server running at http://localhost:${PORT}`);
});
